{#
  Metra service browser, tables and data for one Metra line.
  Source of truth: ~/projects/tools/metra/custom_templates/metra.jinja (claude-env).
  Deployed copy: /config/custom_templates/metra.jinja -- run
  homeassistant.reload_custom_templates after changing it.

  LAYOUT: helpers, then the *_data macros, then the renderers.
  The *_data macros hold ALL the schedule logic and emit JSON. Every renderer
  below only formats what a *_data macro returns and computes nothing of its
  own, so the table view and the data view can never drift apart. Add logic to
  a *_data macro, never to a renderer. Definition order matters: a macro may
  only call one defined above it.

  Usage in a markdown card:
    {%- from 'metra.jinja' import metra_service_browser -%}
    {{- metra_service_browser('MD-N') | safe -}}

  Data form -- pipe through from_json for a real list/dict:
    {%- from 'metra.jinja' import metra_timetable_data -%}
    {%- set trains = metra_timetable_data('UP-W', 'inbound') | from_json -%}
    {{ trains | map(attribute='train') | list | join(', ') }}

  An unknown line, pattern or train yields [] (or null for the single-train
  macro), so callers can test the result with a plain if.

  LINE ARGUMENT: every macro takes a line NAME ('UP-W'). All lines live on
  two entities -- sensor.metra_schedule (attr lines[<name>] = {days, patterns})
  and sensor.metra_active_trains (attr lines[<name>] = trains) -- so no card or
  macro ever builds an entity id. metra_active_trains[_data] take a name, a
  list of names, or none for every configured line, and return trains from
  all of them in one list.
#}

{# ---- helpers ------------------------------------------------------------ #}

{% macro metra_pattern_key(line_ent, pattern=none) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set days = sched.days or [] -%}
{{- pattern if pattern else (days[0].pattern if days else '') -}}
{% endmacro %}

{% macro metra_service_label(line_ent, pkey) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set days = sched.days or [] -%}
{%- if pkey in ['weekday','weekend','saturday','sunday'] -%}
{{- pkey ~ ' service' -}}
{%- else -%}
{%- set hh = days | selectattr('pattern','eq',pkey) | selectattr('holiday','defined') | map(attribute='holiday') | list -%}
{{- hh[0] if hh else 'special service' -}}
{%- endif -%}
{% endmacro %}

{# ---- data: the single source of truth ----------------------------------- #}

{% macro metra_pattern_summary_data(line_ent) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set patterns = sched.patterns or {} -%}
{%- set days = sched.days or [] -%}
{%- set today = days[0].pattern if days else none -%}
{%- set ns = namespace(rows=[]) -%}
{%- for k, p in patterns.items() -%}
{%- set deps = p.trains | map(attribute='departs') | sort | list -%}
{%- set ns.rows = ns.rows + [{
      'key': k,
      'label': metra_service_label(line_ent, k) | trim,
      'today': k == today,
      'count': p.count,
      'inbound': p.trains | selectattr('direction','eq','inbound') | list | count,
      'outbound': p.trains | selectattr('direction','eq','outbound') | list | count,
      'first': deps[0] if deps else none,
      'last': deps[-1] if deps else none }] -%}
{%- endfor -%}
{{- ns.rows | to_json -}}
{% endmacro %}

{% macro metra_timetable_data(line_ent, direction=none, pattern=none, limit=none) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set patterns = sched.patterns or {} -%}
{%- set pkey = metra_pattern_key(line_ent, pattern) | trim -%}
{%- if not pkey or pkey not in patterns -%}
{{- [] | to_json -}}
{%- else -%}
{%- set all = patterns[pkey].trains | sort(attribute='departs') | list -%}
{%- set picked = (all | selectattr('direction','eq',direction) | list) if direction else all -%}
{{- (picked[:limit | int] if limit else picked) | to_json -}}
{%- endif -%}
{% endmacro %}

{% macro metra_stops_table_data(line_ent, train_no, pattern=none) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set patterns = sched.patterns or {} -%}
{%- set pkey = metra_pattern_key(line_ent, pattern) | trim -%}
{%- set trains = patterns[pkey].trains if pkey in patterns else [] -%}
{%- set matches = trains | selectattr('train','eq', train_no | string) | list -%}
{{- (matches[0] if matches else none) | to_json -}}
{% endmacro %}

{% macro metra_service_calendar_data(line_ent) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set days = sched.days or [] -%}
{%- if not days -%}
{{- [] | to_json -}}
{%- else -%}
{%- set ns = namespace(start=none, end=none, sday=none, eday=none, pat=none, hol=none, rows=[]) -%}
{%- for d in days -%}
{%- set h = d.get('holiday','') -%}
{%- if ns.pat != d.pattern or ns.hol != h -%}
{%- if ns.pat is not none -%}
{%- set ns.rows = ns.rows + [{'start': ns.start, 'end': ns.end, 'start_day': ns.sday,
      'end_day': ns.eday, 'pattern': ns.pat,
      'label': metra_service_label(line_ent, ns.pat) | trim,
      'holiday': ns.hol or none}] -%}
{%- endif -%}
{%- set ns.start = d.date -%}
{%- set ns.sday = d.day -%}
{%- set ns.pat = d.pattern -%}
{%- set ns.hol = h -%}
{%- endif -%}
{%- set ns.end = d.date -%}
{%- set ns.eday = d.day -%}
{%- endfor -%}
{{- (ns.rows + [{'start': ns.start, 'end': ns.end, 'start_day': ns.sday,
      'end_day': ns.eday, 'pattern': ns.pat,
      'label': metra_service_label(line_ent, ns.pat) | trim,
      'holiday': ns.hol or none}]) | to_json -}}
{%- endif -%}
{% endmacro %}

{% macro metra_service_browser_data(line_ent, on_date=none) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set days = sched.days or [] -%}
{%- set patterns = sched.patterns or {} -%}
{%- set friendly = ('Metra ' ~ line_ent ~ ' Schedule') if sched else '' -%}
{%- if not days -%}
{{- {'entity': line_ent, 'friendly': friendly, 'line': none, 'loaded': false,
     'in_outlook': false, 'requested_date': on_date, 'selected': none,
     'calendar': [], 'patterns': []} | to_json -}}
{%- else -%}
{%- set sel_list = (days | selectattr('date','eq', on_date|string) | list) if on_date else [] -%}
{%- set sel_day = sel_list[0] if sel_list else none -%}
{%- set today_pat = days[0].pattern -%}
{%- set p_order = [sel_day.pattern] if sel_day
      else ([today_pat] + (patterns.keys()|list|reject('eq', today_pat)|list)) -%}
{%- set ns = namespace(pats=[]) -%}
{%- for k in p_order -%}
{%- set ns.pats = ns.pats + [{
      'key': k,
      'label': metra_service_label(line_ent, k) | trim,
      'in_effect': (k == today_pat) and not sel_day,
      'count': patterns[k].count,
      'trains': patterns[k].trains | sort(attribute='direction,departs') | list }] -%}
{%- endfor -%}
{{- {'entity': line_ent,
     'friendly': friendly,
     'line': friendly | replace(' Schedule',''),
     'loaded': true,
     'first': days[0].date,
     'last': days[days|count - 1].date,
     'first_day': days[0].day,
     'last_day': days[days|count - 1].day,
     'requested_date': on_date,
     'in_outlook': (on_date is none) or (sel_day is not none),
     'selected': sel_day,
     'calendar': metra_service_calendar_data(line_ent) | from_json,
     'patterns': ns.pats} | to_json -}}
{%- endif -%}
{% endmacro %}

{# Live trains for one or more lines. lines = 'UP-W', ['UP-W','UP-NW'], or none
   for every configured line. Trains are grouped by line in request order,
   inbound first, then by ETA; each gains `line` and `terminal_eta`. #}
{% macro metra_active_trains_data(lines=none) %}
{%- set live = state_attr('sensor.metra_active_trains', 'lines') or {} -%}
{%- set wanted = (live.keys() | list) if lines is none else ([lines] if lines is string else lines) -%}
{%- set ns = namespace(trains=[], updated=state_attr('sensor.metra_active_trains', 'updated')) -%}
{%- for line in wanted -%}
{%- for t in (live.get(line) or []) | sort(attribute='direction,eta') -%}
{%- set ns.trains = ns.trains + [dict(t, line=line, terminal_eta=((t.stops | last).eta if t.stops else none))] -%}
{%- endfor -%}
{%- endfor -%}
{{- {'lines': wanted | list, 'updated': ns.updated, 'trains': ns.trains} | to_json -}}
{% endmacro %}

{# ---- renderers: formatting only ----------------------------------------- #}

{% macro metra_service_browser(line_ent, on_date=none) %}
{% set b = metra_service_browser_data(line_ent, on_date) | from_json %}
{% set friendly = b.friendly %}
{% set sel_day = b.selected %}
<b><u>{{ friendly }}</u></b>
{% if b.loaded %}
{% set day_first = b.first_day ~ ', ' ~ b.first %}
{% set day_last = b.last_day ~ ', ' ~ b.last %}
{%- set cal = b.calendar %}
{% if not b.in_outlook %}
_No service data for {{ on_date }} — outside the published outlook ({{ b.first }} → {{ b.last }})._
{% else %}
{%- set pats = b.patterns %}{% set budget = namespace(left=240000) %}

{% if not sel_day %}
<details>
<summary><code><b>Service by date:</b> {{ day_first }} → {{ day_last }}</code></summary>
{%- for r in cal %}
<code>  {{ (r.start ~ ' → ' ~ r.end) | replace(' ', ' ') }}  {{ (r.label ~ ((' — ' ~ r.holiday) if (r.holiday and r.holiday != r.label) else '')) | title | replace(' ', ' ') }}</code><br>
{%- endfor %}
</details>
{% endif %}
{% for p in pats %}
{%- set trains = p.trains %}{% set full %}
<br>
<details>
<summary><code>  <b>{% if sel_day %}{{ sel_day.day[:3] }}, {{ sel_day.date | replace('-','.') }} · {% endif %}{{ p.label | title }}</b> — {{ p.count }} trains{% if p.in_effect %} · in effect now{% endif %}{% if sel_day and sel_day.holiday is defined %} · {{ sel_day.holiday }}{% endif %}</code></summary>

{% for t in trains %}
{%- if loop.changed(t.direction) %}
<code>    <b><i>{{ t.direction|upper }}</i></b></code>
{% endif %}
<details>
<summary><code>    {{ '%-5s'|format('#' ~ t.train) | replace(' ', ' ') }}  {{ t.departs }} → {{ t.arrives }}  {{ t.origin | replace(' ', ' ') }} → {{ t.destination | replace(' ', ' ') }}</code></summary>

{%- for s in t.stations %}
<code>         {{ '%-24s'|format(s.station) | replace(' ', ' ') }}{{ s.time }}</code><br>
{%- endfor %}

</details>
{% endfor %}

</details>
{% endset %}
{%- if full | length <= budget.left %}{% set budget.left = budget.left - (full | length) %}{{ full }}{% else %}{% set brief %}
<br>
<details>
<summary><code>  <b>{% if sel_day %}{{ sel_day.day[:3] }}, {{ sel_day.date | replace('-','.') }} · {% endif %}{{ p.label | title }}</b> — {{ p.count }} trains{% if p.in_effect %} · in effect now{% endif %}{% if sel_day and sel_day.holiday is defined %} · {{ sel_day.holiday }}{% endif %}</code></summary>

<code>    <i>Stop lists omitted to stay under HA's 256 KiB template limit — pass a date to see this service in full.</i></code><br>
{%- for t in trains %}
{%- if loop.changed(t.direction) %}
<code>    <b><i>{{ t.direction|upper }}</i></b></code><br>
{%- endif %}
<code>    {{ '%-5s'|format('#' ~ t.train) | replace(' ', ' ') }}  {{ t.departs }} → {{ t.arrives }}  {{ t.origin | replace(' ', ' ') }} → {{ t.destination | replace(' ', ' ') }}</code><br>
{%- endfor %}

</details>
{% endset %}{% set budget.left = budget.left - (brief | length) %}{{ brief }}{% endif %}{% endfor %}
{% endif %}
{% else %}
_Schedule data not loaded for {{ line_ent }}._
{% endif %}
{% endmacro %}

{% macro metra_timetable(line_ent, direction='inbound', pattern=none, limit=none) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set patterns = sched.patterns or {} -%}
{%- set pkey = metra_pattern_key(line_ent, pattern) | trim -%}
{%- if not pkey or pkey not in patterns -%}
_No schedule data for {{ line_ent }}{{ (' pattern ' ~ pattern) if pattern else '' }}._
{%- else -%}
{%- set trains = metra_timetable_data(line_ent, direction, pattern) | from_json -%}
{%- set shown = trains[:limit | int] if limit else trains -%}
**{{ ('Metra ' ~ line_ent) }}** · {{ metra_service_label(line_ent, pkey) | trim | title }} · {{ direction }} — {{ trains | count }} trains{% if limit and (trains | count) > (shown | count) %}, first {{ shown | count }}{% endif %}

| Train | Depart | Arrive | From | To | Stops |
|:--|--:|--:|:--|:--|--:|
{% for t in shown %}| #{{ t.train }} | {{ t.departs }} | {{ t.arrives }} | {{ t.origin }} | {{ t.destination }} | {{ t.stations | count }} |
{% endfor %}
{%- endif -%}
{% endmacro %}

{% macro metra_stops_table(line_ent, train_no, pattern=none) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set pkey = metra_pattern_key(line_ent, pattern) | trim -%}
{%- set t = metra_stops_table_data(line_ent, train_no, pattern) | from_json -%}
{%- if not t -%}
_Train #{{ train_no }} is not in the {{ (metra_service_label(line_ent, pkey) | trim) if pkey else 'current' }} schedule._
{%- else -%}
**#{{ t.train }}** · {{ t.direction }} · {{ t.origin }} {{ t.departs }} → {{ t.destination }} {{ t.arrives }}

| # | Station | Time |
|--:|:--|--:|
{% for s in t.stations %}| {{ loop.index }} | {{ s.station }} | {{ s.time }} |
{% endfor %}
{%- endif -%}
{% endmacro %}

{% macro metra_pattern_summary(line_ent) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set rows = metra_pattern_summary_data(line_ent) | from_json -%}
{%- if not rows -%}
_No schedule data for {{ line_ent }}._
{%- else -%}
| Service | Trains | In | Out | First | Last |
|:--|--:|--:|--:|--:|--:|
{% for r in rows %}| {{ r.label | title }}{% if r.today %} (today){% endif %} | {{ r.count }} | {{ r.inbound }} | {{ r.outbound }} | {{ r.first or '—' }} | {{ r.last or '—' }} |
{% endfor %}
{%- endif -%}
{% endmacro %}

{% macro metra_service_calendar(line_ent) %}
{%- set sched = (state_attr('sensor.metra_schedule', 'lines') or {}).get(line_ent) or {} -%}
{%- set rows = metra_service_calendar_data(line_ent) | from_json -%}
{%- if not rows -%}
_No service outlook for {{ line_ent }}._
{%- else -%}
**{{ ('Metra ' ~ line_ent) }}** · {{ rows[0].start }} → {{ rows[-1].end }}

| Dates | Days | Service |
|:--|:--|:--|
{% for r in rows %}{% set lbl = r.label | title %}| {{ r.start }}{% if r.end != r.start %} → {{ r.end }}{% endif %} | {{ r.start_day[:3] }}{% if r.end != r.start %}–{{ r.end_day[:3] }}{% endif %} | {{ lbl }}{% if r.holiday and (r.holiday | title) != lbl %} — {{ r.holiday }}{% endif %} |
{% endfor %}
{%- endif -%}
{% endmacro %}

{% macro metra_active_trains(lines=none) %}
{%- set a = metra_active_trains_data(lines) | from_json -%}
{%- set multi = (a.lines | count) > 1 -%}
{%- set title = 'network' if lines is none else (a.lines | join(', ') or 'no lines') -%}
{%- set trains = a.trains -%}
**Metra {{ title }}** · {{ trains | count }} active · updated {{ a.updated or '—' }}

{% if not trains -%}
_No {{ title }} trains running right now._
{%- else -%}
| Train |{{ ' Line |' if multi else '' }} Dir | Next station | ETA | Delay | Terminal |
|:--|{{ ':--|' if multi else '' }}:--|:--|--:|--:|:--|
{% for t in trains -%}
{%- set d = t.delay_min -%}
{%- set delay = '—' if d is none else ('on time' if d == 0 else ('+' ~ d ~ 'm' if d > 0 else d ~ 'm')) -%}
| #{{ t.train }} |{{ (' ' ~ t.line ~ ' |') if multi else '' }} {{ t.direction }} | {{ t.next_station }} | {{ t.eta }} | {{ delay }} | {{ t.destination }}{{ ' ' ~ t.terminal_eta if t.terminal_eta else '' }} |
{% endfor -%}
{%- endif -%}
{% endmacro %}
